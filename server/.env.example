# SQLite file, relative to server/prisma/ (local development and tests)
DATABASE_URL="file:./dev.db"
PORT=3000

# Production only: Turso (hosted SQLite). When set, the app uses Turso instead of
# the local file. Never commit real values; on Render they are dashboard secrets.
# TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token>"
